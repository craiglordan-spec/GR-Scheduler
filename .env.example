# ─── GR Scheduler configuration ───────────────────────────────────────────────
# Copy these into Railway → Variables. Do not commit real values.

PORT=4100

# Users and roles.  Format:  username:password:role  (comma-separated)
# Roles: admin | scheduler | viewer
# If unset, a single admin/admin account is created (change it!).
USERS=admin:changeme:admin,craig:changeme:scheduler,client:readonly:viewer

# Secret used to sign session tokens (any long random string)
SESSION_SECRET=please-set-a-long-random-string

# ─── Link to InvoiceDesk (server-to-server, read-only) ────────────────────────
# Base URL of the running InvoiceDesk app (no trailing slash)
INVOICEDESK_URL=https://gr-project-control-production.up.railway.app
# The read-only API key you set on InvoiceDesk (INVOICEDESK_READ_KEY there).
# Leave blank to run the Scheduler on bundled sample data.
INVOICEDESK_API_KEY=
# How long (seconds) to cache InvoiceDesk reads
INVOICEDESK_CACHE_TTL=60
